# Copy to .env.local for local dev. On Vercel, set these in Project Settings -> Environment Variables.

# --- Frontend (public, safe in the browser) ---
# true  = UI reads public/mock/*.json, no backend needed (UI development / offline demo)
# false = UI calls the Python backend at /api/py/*
NEXT_PUBLIC_USE_MOCK=true

# --- Backend (server-only; never prefix with NEXT_PUBLIC_) ---
# Leave empty to run the team's MCP server from ../src locally (started automatically over stdio).
# Set only to use a remotely deployed copy of that server (Streamable HTTP).
MCP_SERVER_URL=
# Optional bearer token sent to the MCP server.
MCP_API_KEY=
# Optional: chat uses Gemini to extract preferences; without it a rule-based parser is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: Python used to launch the src/ MCP server (defaults to the backend's own Python).
MCP_PYTHON=
# Optional: data folder for the MCP server. Default: the repo's data/, data/cleaned/ and data/raw/
# CSVs, linked into one temp folder (the server expects them in one flat folder).
FLOW_DATA_DIR=
