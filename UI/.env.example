# Copy to .env.local for local dev. On Vercel, set these in Project Settings -> Environment Variables.

# --- Frontend (public, safe in the browser) ---
# true  = UI reads public/mock/*.json, no backend needed (UI development / offline demo)
# false = UI calls the Python backend at /api/py/*
NEXT_PUBLIC_USE_MOCK=true

# --- Backend (server-only; never prefix with NEXT_PUBLIC_) ---
# Streamable-HTTP URL of the MCP server that exposes score_zips, get_zip_details, explain_fit.
# Leave empty until the MCP server exists -> backend answers 503 "engine not connected".
MCP_SERVER_URL=
# Optional bearer token sent to the MCP server.
MCP_API_KEY=
# Optional: chat uses Gemini to extract preferences; without it a rule-based parser is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
